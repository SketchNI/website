{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3|^8.4",
        "devdot/monolog-parser": "^1.6",
        "embed/embed": "^4.4.15",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image-laravel": "^1.3",
        "laravel/framework": "^11.37",
        "laravel/sanctum": "^4.0.7",
        "laravel/tinker": "^2.10",
        "olssonm/ampersand": "^1.4",
        "opcodesio/log-viewer": "^3.12",
        "spatie/laravel-activitylog": "^4.9.1",
        "spatie/laravel-backup": "^9.2",
        "spatie/laravel-medialibrary": "^11.11.1",
        "spatie/laravel-permission": "^6.10.1",
        "spatie/laravel-sitemap": "^7.3.1",
        "spatie/laravel-sluggable": "^3.7.2",
        "spatie/laravel-tags": "^4.9",
        "tightenco/ziggy": "^2.4.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.0.2",
        "laravel/breeze": "^2.3",
        "laravel/pail": "^1.2.1",
        "laravel/pint": ">=1.19",
        "laravel/sail": "^1.39.1",
        "laravel/telescope": "^5.2.6",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.7.1",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.1.1",
        "ryoluo/sail-ssl": "^1.3.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"sail artisan queue:listen --tries=1\" \"sail artisan pail --timeout=0\" \"pnpm run dev\" --names=queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
