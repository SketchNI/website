{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-exif": "*",
        "ext-openssl": "*",
        "embed/embed": "^4.4.17",
        "guzzlehttp/psr7": "^2.8.0",
        "inertiajs/inertia-laravel": "^2.0.21",
        "laravel/framework": "^12.53.0",
        "laravel/sanctum": "v4.0.8",
        "laravel/socialite": "^5.24.3",
        "laravel/tinker": "^2.11.1",
        "livewire/livewire": "^3.7.11",
        "qirolab/laravel-reactions": "^3.1",
        "socialiteproviders/github": "^4.1",
        "spatie/laravel-activitylog": "^4.12.1",
        "spatie/laravel-backup": "^9.4.1",
        "spatie/laravel-permission": "^6.24.1",
        "spatie/laravel-sitemap": "^7.4.0",
        "spatie/laravel-sluggable": "^3.8.0",
        "spatie/laravel-tags": "^4.11.0",
        "spatie/last-fm-now-playing": "^1.1.2",
        "tightenco/ziggy": "^2.6.1",
        "venturecraft/revisionable": "^1.43"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16.5",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.3",
        "laravel/breeze": "^2.3.8",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.27.1",
        "laravel/sail": "^1.53.0",
        "laravel/telescope": "^5.18.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.1",
        "pestphp/pest": "^3.8.5",
        "pestphp/pest-plugin-laravel": "^3.2.0",
        "phpstan/phpstan": "^2.1.40"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "prod": [
            "@php artisan down --retry=5",
            "@php artisan clear-compiled",
            "@php artisan optimize:clear",
            "composer install",
            "@php artisan package:discover --ansi",
            "npm install",
            "npm run build",
            "@php artisan optimize",
            "@php artisan route:clear",
            "@php artisan up"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
